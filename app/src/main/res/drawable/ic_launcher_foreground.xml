<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- White play glyph centred on the canvas. Kept inside the 66dp safe zone
         (roughly x/y 21..87) so no part is clipped by any launcher mask shape. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M37.5,33v42l33,-21z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- "No ads" symbol: circle with diagonal slash over a small ad rectangle -->
    <group android:translateX="70" android:translateY="70">
        <!-- Ad rectangle (small) -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M-8,-4h16v8h-16z"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        
        <!-- "AD" text representation - two small rectangles -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.5"
            android:pathData="M-6,-2h4M-6,2h4M2,-2h4M2,2h4" />
        
        <!-- Prohibition circle -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="3"
            android:pathData="M0,0m-16,0a16,16 0 1,0 32,0a16,16 0 1,0 -32,0" />
        
        <!-- Diagonal slash -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:pathData="M-18,-18 L18,18" />
    </group>
</vector>